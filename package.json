{
  "name": "chatterdesk",
  "version": "1.0.0",
  "description": "Enterprise WhatsApp webhook ingestion service with Fastify, Kafka, and Prisma",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format cjs --dts --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:start:staging": "pm2 start ecosystem.config.cjs --env staging",
    "pm2:reload": "pm2 reload chatterdesk",
    "pm2:restart": "pm2 restart chatterdesk",
    "pm2:stop": "pm2 stop chatterdesk",
    "pm2:delete": "pm2 delete chatterdesk",
    "pm2:logs": "pm2 logs chatterdesk",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save",
    "deploy": "npm run prisma:generate && npm run build && npm run pm2:reload"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "pm2": "^7.0.1",
    "prettier": "^3.3.2",
    "prisma": "^7.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
