# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://chatterdesk:secret@localhost:5432/chatterdesk?schema=public"

# JWT (min 32 chars)
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=chatterdesk
KAFKA_GROUP_ID=chatterdesk-consumers
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# WhatsApp platform-level (shared across all tenants using one Meta App)
WHATSAPP_VERIFY_TOKEN=your_platform_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# WhatsApp Cloud API
WA_GRAPH_API_BASE=https://graph.facebook.com
WA_GRAPH_API_VERSION=v21.0

# Security
WEBHOOK_SIGNATURE_HEADER=x-hub-signature-256
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
