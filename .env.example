# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://chatterdesk:secret@localhost:5432/chatterdesk?schema=public"

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=chatterdesk
KAFKA_GROUP_ID=chatterdesk-consumers
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# WhatsApp
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_APP_SECRET=your_app_secret_here

# Security
WEBHOOK_SIGNATURE_HEADER=x-hub-signature-256
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
